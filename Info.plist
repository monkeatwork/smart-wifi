<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleIdentifier</key>
	<string>io.github.monkeatwork.smartwifi</string>
	<key>CFBundleName</key>
	<string>SmartWiFi</string>
	<key>CFBundleExecutable</key>
	<string>smartwifi</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleVersion</key>
	<string>2</string>
	<key>CFBundleShortVersionString</key>
	<string>1.0</string>
	<key>LSMinimumSystemVersion</key>
	<string>15.0</string>
	<key>LSUIElement</key>
	<true/>
	<!-- Captive portals (Pronto included) are plain HTTP; without this ATS
	     rejects the login POST with NSURLErrorDomain -1022. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<true/>
	</dict>
	<key>NSLocalNetworkUsageDescription</key>
	<string>SmartWiFi listens on your Tailscale address so the buttons in its phone notification can answer the "turn off Tailscale?" question.</string>
	<key>NSLocationUsageDescription</key>
	<string>SmartWiFi needs Location access because macOS hides Wi-Fi network names without it. It uses the names to switch between the networks you set up.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>SmartWiFi needs Location access because macOS hides Wi-Fi network names without it. It uses the names to switch between the networks you set up.</string>
</dict>
</plist>
